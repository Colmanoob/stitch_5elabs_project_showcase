# Restrict execution of server-side scripts in this directory
<FilesMatch "\.(php|php3|php4|php5|phtml|pl|cgi|py|sh|exe)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Force download for certain types
<FilesMatch "\.(zip|rar|7z|tar|gz)$">
    ForceType application/octet-stream
    Header set Content-Disposition attachment
</FilesMatch>

# Disable directory browsing
Options -Indexes
